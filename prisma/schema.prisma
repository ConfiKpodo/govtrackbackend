generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model agencies {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ministry_id String     @db.Uuid
  name        String     @db.VarChar(200)
  code        String?    @unique @db.VarChar(50)
  description String?
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  ministries  ministries @relation(fields: [ministry_id], references: [id], map: "fk_agency_ministry")
  projects    projects[]
  users       users[]

  @@unique([ministry_id, name])
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_user")

  @@index([action], map: "idx_audit_action")
  @@index([created_at], map: "idx_audit_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([user_id], map: "idx_audit_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model citizen_feedback {
  id                                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                                 String    @db.Uuid
  submitted_by                               String?   @db.Uuid
  citizen_name                               String?   @db.VarChar(150)
  citizen_email                              String?   @db.VarChar(255)
  subject                                    String    @db.VarChar(255)
  message                                    String
  feedback_category                          String    @default("GENERAL") @db.VarChar(40)
  is_anonymous                               Boolean   @default(false)
  status                                     String    @default("NEW") @db.VarChar(30)
  reviewed_by                                String?   @db.Uuid
  reviewed_at                                DateTime? @db.Timestamptz(6)
  response                                   String?
  created_at                                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime  @default(now()) @db.Timestamptz(6)
  projects                                   projects  @relation(fields: [project_id], references: [id], onUpdate: NoAction, map: "fk_feedback_project")
  users_citizen_feedback_reviewed_byTousers  users?    @relation("citizen_feedback_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_feedback_reviewer")
  users_citizen_feedback_submitted_byTousers users?    @relation("citizen_feedback_submitted_byTousers", fields: [submitted_by], references: [id], onUpdate: NoAction, map: "fk_feedback_user")

  @@index([created_at], map: "idx_feedback_created_at")
  @@index([project_id], map: "idx_feedback_project")
  @@index([reviewed_by], map: "idx_feedback_reviewer")
  @@index([status], map: "idx_feedback_status")
}

model contractors {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name        String      @db.VarChar(200)
  registration_number String?     @unique @db.VarChar(100)
  contact_email       String?     @db.VarChar(200)
  contact_phone       String?     @db.VarChar(30)
  address             String?
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @default(now()) @db.Timestamptz(6)
  contracts           contracts[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contracts {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id      String      @db.Uuid
  contractor_id   String      @db.Uuid
  contract_number String      @unique @db.VarChar(100)
  contract_title  String      @db.VarChar(255)
  description     String?
  contract_amount Decimal     @db.Decimal(18, 2)
  currency        String      @default("GHS") @db.VarChar(3)
  award_date      DateTime?   @db.Date
  start_date      DateTime?   @db.Date
  end_date        DateTime?   @db.Date
  status          String      @default("AWARDED") @db.VarChar(30)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)
  contractors     contractors @relation(fields: [contractor_id], references: [id], onUpdate: NoAction)
  projects        projects    @relation(fields: [project_id], references: [id], onUpdate: NoAction)

  @@index([contractor_id], map: "idx_contracts_contractor")
  @@index([project_id], map: "idx_contracts_project")
}

model districts {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region_id  String     @db.Uuid
  name       String     @db.VarChar(150)
  code       String?    @unique @db.VarChar(30)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  regions    regions    @relation(fields: [region_id], references: [id], map: "fk_district_region")
  projects   projects[]

  @@unique([region_id, name])
}

